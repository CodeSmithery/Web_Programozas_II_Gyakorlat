<%- include("partials/header") %>
<div class="w3-flex-column w3-flex-center w3-flex-align-center w3-gap-small w3-padding-32">
    <% if(message){ %><h3 class="message"><%= message %></h3><% } %>
    <form method="POST" class="w3-flex-column w3-flex-center w3-flex-align-center w3-gap-small">
        <input name="username" placeholder="Felhasználónév" required class="w3-container">
        <input type="password" name="password" placeholder="Jelszó" required class="w3-container">
        <button class="w3-container">Regisztráció</button>
    </form>
</div>
<%- include("partials/footer") %>